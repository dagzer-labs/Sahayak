# Application
SAHAYAK__ENVIRONMENT=development
# HTTP server
SAHAYAK__HTTP__HOST=0.0.0.0
SAHAYAK__HTTP__PORT=8080
SAHAYAK__HTTP__REQUEST_TIMEOUT_SECONDS=10
SAHAYAK__HTTP__READINESS_TIMEOUT_SECONDS=2
SAHAYAK__HTTP__SHUTDOWN_GRACE_SECONDS=25
SAHAYAK__HTTP__MAX_REQUEST_BODY_BYTES=3145728

# PostgreSQL
SAHAYAK__DATABASE__URL=postgres://sahayak_app:sahayak_dev@127.0.0.1:55432/sahayak
SAHAYAK__DATABASE__MIN_CONNECTIONS=1
SAHAYAK__DATABASE__MAX_CONNECTIONS=10
SAHAYAK__DATABASE__ACQUIRE_TIMEOUT_SECONDS=5
SAHAYAK__DATABASE__IDLE_TIMEOUT_SECONDS=600
SAHAYAK__DATABASE__MAX_LIFETIME_SECONDS=1800
SAHAYAK__DATABASE__STATEMENT_TIMEOUT_MILLISECONDS=5000
SAHAYAK__DATABASE__LOCK_TIMEOUT_MILLISECONDS=2000
SAHAYAK__DATABASE__IDLE_IN_TRANSACTION_TIMEOUT_MILLISECONDS=10000
SAHAYAK__DATABASE__REQUIRE_TLS=false

# Worker
SAHAYAK__WORKER__HEALTH_INTERVAL_SECONDS=30
SAHAYAK__WORKER__SHUTDOWN_GRACE_SECONDS=10
SAHAYAK__WORKER__JOB_POLL_INTERVAL_MILLISECONDS=250
SAHAYAK__WORKER__JOB_CLAIM_BATCH_SIZE=10
SAHAYAK__WORKER__JOB_LEASE_SECONDS=30
SAHAYAK__WORKER__INBOUND_PAYLOAD_RETENTION_DAYS=14

# WhatsApp Cloud API. Secret files must contain one value and no NUL bytes.
SAHAYAK__WHATSAPP__ENABLED=false
SAHAYAK__WHATSAPP__GRAPH_API_BASE_URL=https://graph.facebook.com
SAHAYAK__WHATSAPP__GRAPH_API_VERSION=v26.0
SAHAYAK__WHATSAPP__WABA_ID=
SAHAYAK__WHATSAPP__PHONE_NUMBER_ID=
SAHAYAK__WHATSAPP__APP_SECRET_CURRENT_FILE=/run/secrets/meta_app_secret_current
SAHAYAK__WHATSAPP__APP_SECRET_PREVIOUS_FILE=
SAHAYAK__WHATSAPP__VERIFY_TOKEN_FILE=/run/secrets/meta_verify_token
SAHAYAK__WHATSAPP__ACCESS_TOKEN_FILE=/run/secrets/meta_access_token
SAHAYAK__WHATSAPP__CRYPTO_KEYRING_FILE=/run/secrets/sahayak_crypto_keyring
SAHAYAK__WHATSAPP__WEBHOOK_MAX_BODY_BYTES=3145728
SAHAYAK__WHATSAPP__REQUEST_TIMEOUT_SECONDS=20
SAHAYAK__WHATSAPP__TRANSPORT_PROBE_ENABLED=false
SAHAYAK__WHATSAPP__REENTRY_TEMPLATE_NAME=sahayak_reentry
SAHAYAK__WHATSAPP__PAYMENT_REMINDER_TEMPLATE_NAME=sahayak_payment_reminder

# Razorpay subscriptions. Keep disabled until test-mode plan and webhook are configured.
SAHAYAK__RAZORPAY__ENABLED=false
SAHAYAK__RAZORPAY__API_BASE_URL=https://api.razorpay.com
SAHAYAK__RAZORPAY__KEY_ID=
SAHAYAK__RAZORPAY__KEY_SECRET_FILE=/run/secrets/razorpay_key_secret
SAHAYAK__RAZORPAY__WEBHOOK_SECRET_CURRENT_FILE=/run/secrets/razorpay_webhook_secret_current
SAHAYAK__RAZORPAY__WEBHOOK_SECRET_PREVIOUS_FILE=
SAHAYAK__RAZORPAY__PLAN_ID=
SAHAYAK__RAZORPAY__WEBHOOK_MAX_BODY_BYTES=262144

# Observability
SAHAYAK__OBSERVABILITY__LOG_FILTER=info,sahayak=debug
SAHAYAK__OBSERVABILITY__LOG_FORMAT=pretty
SAHAYAK__OBSERVABILITY__SENTRY_ENABLED=false
SAHAYAK__OBSERVABILITY__SENTRY_DSN_FILE=/run/secrets/sentry_dsn

# Docker Compose host bindings
SAHAYAK_POSTGRES_PORT=55432
